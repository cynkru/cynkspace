# Build Stage
FROM rust:1.92.0-slim-trixie
USER 0:0
WORKDIR /home/rust/src

ARG CARGO_BUILD_JOBS=10
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}

# Install build requirements
RUN apt-get update && \
    apt-get install -y \
    make \
    pkg-config \
    libdav1d-dev \
    libssl-dev
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build -j "${CARGO_BUILD_JOBS}" --locked --release
